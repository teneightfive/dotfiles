# Brewfile.personal - Personal machine packages
# Usage: brew bundle --file=~/dotfiles/Brewfile.personal
#
# This file includes the base Brewfile and adds personal apps

# Include base packages
instance_eval File.read("#{__dir__}/Brewfile")

# Browsers
cask 'brave-browser'

# Design
cask 'sketch'

# Personal productivity
# cask 'authy' # deprecated
cask 'flux-app'
cask 'google-drive'
cask 'keybase'
# cask 'shift' # deprecated
cask 'evernote'
cask 'imageoptim'
cask 'notion'
cask 'notion-calendar'
cask 'notion-mail'

# Security
cask 'gpg-suite'

# Design
cask 'adobe-creative-cloud'

# Media & Entertainment
cask 'spotify'
cask 'zwift'
# brew 'yt-dlp' # not used

# Document processing
brew 'pandoc'
brew 'weasyprint'
