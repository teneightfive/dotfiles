# Brewfile.personal - Personal machine packages
# Usage: brew bundle --file=~/dotfiles/Brewfile.personal
#
# This file includes the base Brewfile and adds personal apps

# Include base packages
instance_eval File.read("#{__dir__}/Brewfile")

# Browsers
cask 'brave-browser'

# Shell & Terminal
cask 'iterm2'

# Development
cask 'docker-desktop'
cask 'ngrok'

# Design
cask 'sketch'

# Personal productivity
cask 'authy'
cask 'caffeine'
cask 'flux-app'
cask 'google-drive'
cask 'keybase'
cask 'shift'
cask 'evernote'
cask 'imageoptim'
cask 'notion'
cask 'notion-calendar'
cask 'notion-mail'

# Security
cask 'gpg-suite'

# Design
cask 'adobe-creative-cloud'

# Media & Entertainment
cask 'spotify'
cask 'zwift'
brew 'yt-dlp'

# Document processing
brew 'pandoc'
brew 'weasyprint'

# Cloud tools
brew 'heroku'
