# Zsh configuration
# Modernized for 2026 with Starship, Volta, and mise

# Source machine-specific config first (if exists)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Source Homebrew paths (architecture-aware)
source ~/dotfiles/zsh/homebrew.zsh

# Path to your oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Don't set ZSH_THEME - using Starship instead
# ZSH_THEME=""

# Zsh options
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_DOTENV_PROMPT=false

# Plugins - streamlined for performance
# Removed: nvm (using Volta), jira (unused), z (using zoxide)
plugins=(dotenv git kubectl npm sudo zsh-autosuggestions vscode)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Source custom functions
source ~/dotfiles/zsh/functions.zsh

# Bin directory for user scripts
export PATH="$HOME/bin:$PATH"

# Editor
export EDITOR="code"

# Volta for Node.js version management
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# Mise for Ruby/Python version management
if command -v mise &> /dev/null; then
    eval "$(mise activate zsh)"
elif [[ -f ~/.local/bin/mise ]]; then
    eval "$(~/.local/bin/mise activate zsh)"
fi

# Zoxide (smarter cd, replaces z plugin)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init zsh)"
fi

# Starship prompt
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# GPG TTY for signing
export GPG_TTY=$(tty)

# Heroku autocomplete (with $HOME instead of hardcoded path)
HEROKU_AC_ZSH_SETUP_PATH="$HOME/Library/Caches/heroku/autocomplete/zsh_setup"
[[ -f "$HEROKU_AC_ZSH_SETUP_PATH" ]] && source "$HEROKU_AC_ZSH_SETUP_PATH"

# Docker Desktop integration
[[ -f "$HOME/.docker/init-zsh.sh" ]] && source "$HOME/.docker/init-zsh.sh"

# direnv (if installed)
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# Flutter (if installed)
[[ -d "$HOME/development/flutter/bin" ]] && export PATH="$HOME/development/flutter/bin:$PATH"

# Windsurf/Codeium (if installed)
[[ -d "$HOME/.codeium/windsurf/bin" ]] && export PATH="$HOME/.codeium/windsurf/bin:$PATH"

# Fiddler Everywhere (if running)
if [[ -n "$FE_STARTED" ]] && [[ -s '/Applications/Fiddler Everywhere.app/Contents/Resources/app/out/assets/scripts/startup-mac.sh' ]] && [[ "$STARTUP_SOURCED" != "true" ]]; then
    source '/Applications/Fiddler Everywhere.app/Contents/Resources/app/out/assets/scripts/startup-mac.sh'
    STARTUP_SOURCED="true"
fi

# Ngrok (if installed)
if command -v ngrok &>/dev/null; then
    eval "$(ngrok completion)"
fi
